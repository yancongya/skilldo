{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SkillDo",
  "version": "0.7.3",
  "identifier": "com.qufei1993.skillshub",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "SkillDo",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/yancongya/skilldo/releases/latest/download/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1RTlBMTE4M0U5NjM3N0YKUldSL041WStHS0hwcGNZbzdaNi9qd0tqdWk2bEh6MDdLS2RLUnBFa0pHTTBmZVhzQWQ2dHR5WHYK"
    }
  }
}
